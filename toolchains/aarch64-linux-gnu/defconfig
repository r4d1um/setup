# Raspberry Pi 3/4/5 with a 64-bit OS (Debian 12 / Pi OS bookworm): glibc 2.36, generic ARMv8-A
CT_ARCH_ARM=y
CT_ARCH_64=y
CT_CONFIG_VERSION="4"
CT_OMIT_TARGET_VENDOR=y
CT_KERNEL_LINUX=y
CT_LINUX_V_6_1=y
CT_BINUTILS_V_2_40=y
CT_GLIBC_V_2_36=y
CT_GCC_V_12=y
CT_CC_LANG_CXX=y
CT_SAVE_TARBALLS=y
# CT_LOG_PROGRESS_BAR is not set
# CT_PREFIX_DIR_RO is not set
